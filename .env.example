# MongoDB (deployment must support Vector Search)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=coldchain_copilot

# Voyage AI (document and query embeddings)
VOYAGE_API_KEY=
# Rerun scripts/ingest_docs.py after changing the model
VOYAGE_EMBED_MODEL=voyage-4

# OpenAI (briefing LLM; any model that supports tool calling)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Max window for fleet- or reefer-scoped sensor queries; matches the 72h history seed.py writes
MAX_WINDOW_HOURS=72

# Catalog JSON and source documents (relative to the working directory)
DATA_DIR=data
DOCS_DIR=docs
